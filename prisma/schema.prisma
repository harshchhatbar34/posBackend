// Jay Goga POS - Prisma Schema
// Production-ready schema with relations, enums, indexes, timestamps, and soft delete

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ ENUMS ============

enum Role {
  SUPER_ADMIN
  ADMIN
  CHEF
  HELPER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  UNDER_COOK
  COOKED
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum InventoryUnit {
  KG
  GRAM
  LITER
  ML
  PIECE
  PACKET
  BOX
}

// ============ MODELS ============

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(HELPER)
  isActive  Boolean  @default(true)
  resetOtp        String?
  resetOtpExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ordersTaken  Order[] @relation("OrderTakenBy")
  ordersCooked Order[] @relation("OrderChef")
  ordersServed Order[] @relation("OrderServedBy")
  orderLogs    OrderLog[]
  stockLogs    InventoryStockLog[]
  usageLogs    InventoryUsageLog[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model Section {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tables   Table[]
  products Product[]

  @@map("sections")
}

model Table {
  id          String      @id @default(cuid())
  tableNumber Int
  sectionId   String
  status      TableStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([tableNumber, sectionId])
  @@index([sectionId])
  @@index([status])
  @@map("tables")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products Product[]

  @@map("categories")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  price       Float
  categoryId  String
  sectionId   String
  isAvailable Boolean @default(true)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  section    Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([sectionId])
  @@index([isAvailable])
  @@map("products")
}

model Order {
  id            String        @id @default(cuid())
  tableId       String
  status        OrderStatus   @default(PENDING)
  takenById     String
  chefId        String?
  servedById    String?
  totalAmount   Float         @default(0)
  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  table    Table       @relation(fields: [tableId], references: [id])
  takenBy  User        @relation("OrderTakenBy", fields: [takenById], references: [id])
  chef     User?       @relation("OrderChef", fields: [chefId], references: [id])
  servedBy User?       @relation("OrderServedBy", fields: [servedById], references: [id])
  items    OrderItem[]
  logs     OrderLog[]

  @@index([tableId])
  @@index([status])
  @@index([takenById])
  @@index([chefId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  status    OrderItemStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@map("order_items")
}

model OrderLog {
  id        String   @id @default(cuid())
  orderId   String
  action    String
  details   String?
  userId    String
  createdAt DateTime @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([createdAt])
  @@map("order_logs")
}

model InventoryItem {
  id           String        @id @default(cuid())
  name         String
  quantity     Float         @default(0)
  unit         InventoryUnit @default(PIECE)
  location     String?
  pricePerUnit Float         @default(0)
  minStock     Float         @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  stockLogs InventoryStockLog[]
  usageLogs InventoryUsageLog[]

  @@index([name])
  @@map("inventory_items")
}

model InventoryStockLog {
  id              String   @id @default(cuid())
  inventoryItemId String
  quantityAdded   Float
  note            String?
  addedById       String
  createdAt       DateTime @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  addedBy       User          @relation(fields: [addedById], references: [id])

  @@index([inventoryItemId])
  @@index([addedById])
  @@index([createdAt])
  @@map("inventory_stock_logs")
}

model InventoryUsageLog {
  id              String   @id @default(cuid())
  inventoryItemId String
  quantityUsed    Float
  note            String?
  takenById       String
  createdAt       DateTime @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  takenBy       User          @relation(fields: [takenById], references: [id])

  @@index([inventoryItemId])
  @@index([takenById])
  @@index([createdAt])
  @@map("inventory_usage_logs")
}
